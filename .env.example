# Template Konfigurasi Kredensial Akun Dummy (Ganti dengan akun Anda)
# JANGAN PERNAH MENGUNGGAH FILE .env ASLI KE GITHUB!

# Facebook Dummy Credentials
FB_USER=your_email_or_phone
FB_PASS=your_password

# Instagram & Threads Dummy Credentials
IG_USER=your_instagram_username
IG_PASS=your_password

# TikTok Dummy Credentials
TIKTOK_EMAIL=your_email@gmail.com
TIKTOK_PASS=your_password
